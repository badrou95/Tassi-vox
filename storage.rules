rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasDirectVerifiedEmail() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    function hasGoogleIdentityEmail() {
      return request.auth != null
        && 'firebase' in request.auth.token
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && 'identities' in request.auth.token.firebase
        && 'email' in request.auth.token.firebase.identities
        && request.auth.token.firebase.identities.email is list
        && request.auth.token.firebase.identities.email.size() > 0
        && request.auth.token.firebase.identities.email[0] is string
        && request.auth.token.firebase.identities.email[0].size() > 0;
    }

    function isVerifiedUser() {
      return hasDirectVerifiedEmail() || hasGoogleIdentityEmail();
    }

    function userEmail() {
      return hasDirectVerifiedEmail()
        ? request.auth.token.email.lower()
        : request.auth.token.firebase.identities.email[0].lower();
    }

    function isVerifiedFamily() {
      return isVerifiedUser()
        && (
          userEmail() == 'tmerzak@gmail.com' ||
          userEmail() == 'badroumc@gmail.com' ||
          userEmail() == 'tigrine156@gmail.com' ||
          userEmail() == 'tigrinemelissalyna@gmail.com'
        );
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
    }

    // Strict security cap for external journalist uploads: 2 MB max, JPG/PNG/WebP only (no SVG XSS)
    function isValidExternalImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Public editorial media (article covers, site logo, journalist portraits)
    match /media/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedFamily()
        && folder in ['articles', 'journalists', 'branding']
        && isValidImageUpload();
      allow delete: if isVerifiedFamily()
        && folder in ['articles', 'journalists', 'branding'];
    }

    // External journalist article photos (strictly <= 2 MB, JPG/PNG/WebP, scoped to UID)
    match /submission-images/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedUser()
        && request.auth.uid == uid
        && isValidExternalImageUpload();
      allow delete: if isVerifiedFamily() || (isVerifiedUser() && request.auth.uid == uid);
    }

    // External journalist self-managed portrait upload scoped to their UID (<= 2 MB)
    match /journalist-avatars/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedUser()
        && request.auth.uid == uid
        && isValidExternalImageUpload();
      allow delete: if isVerifiedFamily() || (isVerifiedUser() && request.auth.uid == uid);
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
